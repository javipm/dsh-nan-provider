{
  "name": "dsh-nan-provider",
  "version": "0.2.3",
  "description": "NaN (nan.builders) provider setup and subscription usage for the DeepSeek Harness TUI, based on the pi-nan-provider approach: creates the provider, stores the key, sets the default model and shows credits in a sidebar panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nan",
    "usage",
    "credits"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "scripts",
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.en.md",
    "docs/panel.jpg",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1"
  },
  "author": "javipm",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javipm/dsh-nan-provider.git"
  },
  "homepage": "https://github.com/javipm/dsh-nan-provider#readme",
  "bugs": {
    "url": "https://github.com/javipm/dsh-nan-provider/issues"
  }
}
