{
  "name": "dsh-nan-provider",
  "version": "0.3.0",
  "description": "NaN (nan.builders) provider setup and subscription usage for the DeepSeek Harness TUI, based on the pi-nan-provider approach: creates the provider, stores the key, sets the default model and shows credits in a sidebar panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nan",
    "usage",
    "credits"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "client.js",
    "scripts",
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "docs/panel.jpg",
    "docs/web-settings.webp",
    "docs/web-chip.webp",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check client.js && node --test test/*.test.js && npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1"
  },
  "author": "javipm",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javipm/dsh-nan-provider.git"
  },
  "homepage": "https://github.com/javipm/dsh-nan-provider#readme",
  "bugs": {
    "url": "https://github.com/javipm/dsh-nan-provider/issues"
  }
}
